{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${AUGGIE_PLUGIN_ROOT}/hooks/pre_edit_check.sh"
            ],
            "timeout": 5000
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${AUGGIE_PLUGIN_ROOT}/hooks/post_edit_notify.sh"
            ],
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
